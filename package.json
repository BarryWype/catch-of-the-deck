{
  "name": "catch-of-the-deck",
  "private": true,
  "version": "0.1.26",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-audio.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "sprites": "node scripts/generate-creature-sprites.mjs",
    "store-art": "node scripts/generate-store-art.mjs",
    "shore": "node scripts/draw-shore.mjs",
    "hurt-sprites": "node scripts/generate-hurt-sprites.mjs",
    "sea": "node scripts/draw-sea.mjs",
    "coast": "node scripts/draw-coast.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "VITE_DEV_SERVER_URL=http://localhost:5190 electron .",
    "electron:build": "npm run build && electron-builder",
    "simulate": "node scripts/simulate.mjs",
    "reward-shares": "node scripts/reward-shares.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "pngjs": "^7.0.0",
    "typescript": "~5.6.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  },
  "build": {
    "appId": "nz.co.barrywype.catchofthedeck",
    "productName": "Catch of the Deck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "mac": {
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Catch of the Deck uses the camera to scan a save transfer code from another device."
      },
      "artifactName": "catch-of-the-deck-mac-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "catch-of-the-deck-windows.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "catch-of-the-deck-linux.${ext}"
    }
  }
}
